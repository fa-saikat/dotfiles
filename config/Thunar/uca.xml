	<icon>link</icon>
	<name>In source</name>
	<submenu>Symlink</submenu>
	<unique-id>1721750222391156-2</unique-id>
	<command>ln -sfn %f &quot;$HOME/.local/src/$(basename %f)&quot;</command>
	<description>Create symlink in local/src</description>
	<range>*</range>
	<patterns>dmenu;dwm;st;slstatus;slock</patterns>
