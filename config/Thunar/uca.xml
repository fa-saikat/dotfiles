</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as wallpaper (Primary Monitor)</name>
	<submenu>Set as background</submenu>
	<unique-id>1721500343017935-2</unique-id>
	<command>nitrogen --head=0 --set-scaled %f</command>
	<description>Set as wallpaper</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as wallpaper (Secondary Monitor)</name>
	<submenu>Set as background</submenu>
	<unique-id>1721500270426469-1</unique-id>
	<command>nitrogen --head=1 --set-scaled %f</command>
	<description>Set as wallpaper on second monitor</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as wllapaper (Blurred)</name>
	<submenu>Set as background</submenu>
	<unique-id>1721504279556038-3</unique-id>
	<command>convert %f -blur 0x6 &quot;$HOME/.cache/desktopbg&quot;; nitrogen --save --head=0 --set-scaled &quot;$HOME/.cache/desktopbg&quot;</command>
	<description>Set blurred version of  the wallpaper</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>blurfx</icon>
	<name>Add blur effect</name>
	<submenu>Image options</submenu>
	<unique-id>1721503141648145-2</unique-id>
	<command>convert %f -blur 0x6 &quot;blurred-$(basename %f)&quot;</command>
	<description>Add blur effect to images</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>system-reboot</icon>
	<name>Convert webp to jpg</name>
	<submenu></submenu>
	<unique-id>1510662686010963-2</unique-id>
	<command>convert %f -quality 100 `basename %f .webp`.jpg</command>
	<description>Convert webp to jpg</description>
	<range></range>
	<patterns>*.webp</patterns>
	<image-files/>
</action>
<action>
	<icon>gksu-root-terminal</icon>
	<name>Ownership to root</name>
	<submenu>Ownership</submenu>
	<unique-id>1526631155250282-8</unique-id>
	<command>gnome-keyring-daemon -r -d;gksu &quot;chown -R root:root %F&quot;</command>
	<description>Change permissions to root</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>system-switch-user</icon>
	<name>Ownership to user</name>
	<submenu>Ownership</submenu>
	<unique-id>1526631178674034-9</unique-id>
	<command>gnome-keyring-daemon -r -d;gksu &quot;chown -R $USER:$USER %F&quot;</command>
	<description>Change permissions to user</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
