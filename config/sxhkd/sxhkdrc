# ==============================================================
# ========================= SXHKD ==============================
# ======== Keybindings for any tiling Window Manager ===========
# ==============================================================
super + r
    rofi -show drun

super + n
    ${HOME}/.local/bin/dmenu-emoji.sh

super + o
    ${DOTFILES_HOME}/bin/dmenu-monitor.sh

super + shift + o
	${DOTFILES_HOME}/bin/dmenu-resolution.sh

# switch keyboard switch keyboard layouit
super + i
	bash -x switch-keyboard.sh > /tmp/sxhkd.log 2>&1
	# bash -x $DOTFILES_HOME/bin/switch-keyboard.sh > /tmp/sxhkd.log 2>&1

super + x
    bash $HOME/.local/bin/dmenu-power.sh

# Xkill
super + Escape
    xkill

